# Local defaults. For hosting, set NODE_ENV=production and a real HTTPS origin.
NODE_ENV=development
ALLOW_SQLITE_PRODUCTION=false
APP_ORIGIN=http://127.0.0.1:8766
HOST=127.0.0.1
PORT=8766
DATA_DIR=./data
SESSION_DAYS=7

# Empty DATABASE_URL selects local SQLite. Never put secrets in public/.
DATABASE_URL=
POSTGRES_SSL=false
# Optional trusted CA PEM text, if the database uses a private CA.
POSTGRES_SSL_CA=

# Optional Supabase private storage: configure all three values together.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Only for the optional Compose postgres service; choose a strong secret.
POSTGRES_PASSWORD=
